# WasteX Environment Configuration — TEMPLATE
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values before running install.bat.
# The .env file is NEVER committed to git.
# ─────────────────────────────────────────────────────────────────────────────

# ----------------------------------------------------------------------------
# SECURITY
# ----------------------------------------------------------------------------

# Required — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE_ME_generate_a_real_key

# True only during local development. Always False in production.
DEBUG=False

# Comma-separated list of hostnames/IPs this server will respond to.
# Include the machine's LAN IP so Raspberry Pis can reach it.
# Example: localhost,127.0.0.1,192.168.1.10
ALLOWED_HOSTS=localhost,127.0.0.1

# ----------------------------------------------------------------------------
# DATABASE  (PostgreSQL)
# ----------------------------------------------------------------------------

DB_NAME=wastex
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_HOST=localhost
DB_PORT=5432

# ----------------------------------------------------------------------------
# STORAGE PATHS
# ----------------------------------------------------------------------------

# Where uploaded/OOD images are stored.
# Recommended: a folder on a large drive, e.g. D:\WasteX\media
WASTE_MEDIA_ROOT=C:\WasteX\media

# Where training datasets are stored.
WASTE_DATASETS_ROOT=C:\WasteX\datasets

# Where trained model checkpoints are saved (optional, defaults to ./models).
# WASTE_MODELS_ROOT=C:\WasteX\models
