# WasteX Environment Configuration — TEMPLATE
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values before running install.bat.
# The .env file is NEVER committed to git.
# ─────────────────────────────────────────────────────────────────────────────

# ----------------------------------------------------------------------------
# SECURITY
# ----------------------------------------------------------------------------

# Required — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE_ME_generate_a_real_key

# True only during local development. Always False in production.
DEBUG=False

# Comma-separated list of hostnames/IPs this server will respond to.
# Include the machine's LAN IP so Raspberry Pis can reach it.
# Example: localhost,127.0.0.1,192.168.1.10
ALLOWED_HOSTS=localhost,127.0.0.1

# ----------------------------------------------------------------------------
# SITE ROLE & CLOUD BROKER
# ----------------------------------------------------------------------------

# Role of this installation: EDGE, MASTER, or CLOUD
SITE_ROLE=EDGE

# Unique ID for this installation (e.g., NY_01, PARIS_MAIN)
SITE_ID=LOCAL_DEV

# If this is EDGE or MASTER, provide the URL of your CLOUD Broker
# CLOUD_BROKER_URL=https://your-app.onrender.com
# CLOUD_BROKER_TOKEN=your_api_token_here

# ----------------------------------------------------------------------------
# CLOUD STORAGE (Backblaze B2)
# ----------------------------------------------------------------------------
# Required ONLY if SITE_ROLE=CLOUD

 B2_APPLICATION_KEY_ID=ddb945db6340
 B2_APPLICATION_KEY=005687f8a852f82c1ec0a95a9b96c241bd29951b0a
 B2_BUCKET_NAME=wastex
 B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
 B2_REGION=us-east-005

# ----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# ----------------------------------------------------------------------------

DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=mynameis@Siam007
DB_HOST=db.lpalbvmnzkfimwjcdgnx.supabase.co
DB_PORT=5432
DB_SSL_MODE=require


# ----------------------------------------------------------------------------
# LOCAL STORAGE PATHS (Not used if SITE_ROLE=CLOUD)
# ----------------------------------------------------------------------------

# Where uploaded/OOD images are stored.
WASTE_MEDIA_ROOT=C:\WasteX\media

# Where training datasets are stored.
WASTE_DATASETS_ROOT=C:\WasteX\datasets

# Where trained model checkpoints are saved.
WASTE_MODELS_ROOT=C:\WasteX\models
